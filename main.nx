// Demo do `noxy --sync`: duas dependências vindas do noxy.mod + noxy.sum.
//
//   git clone <este repo> && cd noxy-sync-demo
//   noxy --sync          # instala noxy_libs a partir do lock (precisa de rede na primeira vez)
//   noxy main.nx
//
// quicksort é um pacote de fonte (.nx); noxy_dynamodb é uma extensão por
// processo (binário baixado da release e verificado pelo noxy.sum).

use errors select *
use sys
use github_com.estevaofon.quicksort.quicksort select *
use github_com.estevaofon.noxy_dynamodb as dynamodb

func main() -> void
    // 1. Pacote de fonte: ordena com o quicksort instalado em noxy_libs.
    let numeros: int[] = [42, 7, 19, 3, 88, 1, 56, 23]
    quicksort(ref numeros, 0, length(numeros) - 1)
    print(f"quicksort: {numeros}")

    // 2. Extensão por processo: conecta e faz um scan. Credenciais vêm do
    //    ambiente (AWS_PROFILE, AWS_ACCESS_KEY_ID..., ~/.aws/credentials);
    //    DYNAMO_TABLE escolhe a tabela (default: noxy_sync_demo). Sem
    //    credenciais ou sem a tabela o scan falha e isso é esperado: o que
    //    importa é o binário do plugin ter sido baixado, verificado e
    //    iniciado pelo sync.
    let tabela: string = "noxy_sync_demo"
    let env = sys.getenv("DYNAMO_TABLE")
    if env.ok then
        tabela = env.value
    end
    let conn = call_result(dynamodb.connect, {"region": "us-east-1"})
    if !conn.ok then
        print(f"dynamodb: connect falhou: {conn.failure.message}")
        return
    end
    let client: dynamodb.Client = conn.value
    let scan = call_result(dynamodb.scan, client, tabela, 5)
    if scan.ok then
        print(f"dynamodb: scan de '{tabela}' devolveu {length(scan.value)} item(ns)")
        for item in scan.value do
            print(f"  {item}")
        end
    else
        print(f"dynamodb: extensão carregada; scan de '{tabela}' falhou: {scan.failure.message}")
    end
    dynamodb.close(client)
end

main()
